# Windows batch files must keep CRLF line endings: cmd.exe mis-reads labels
# (goto) in LF-only files.
*.bat text eol=crlf

# Left out of the release ZIP (git archive) and GitHub's "Download ZIP":
# only developers need these - they clone the repo.
tests/ export-ignore
docs/ export-ignore
CLAUDE.md export-ignore
ROADMAP.md export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
